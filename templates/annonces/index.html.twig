{% extends 'base.html.twig' %}

{% block title %}Liste des Annonces{% endblock %}

{% block body %}
<script>
    const page = Number(urlParams.get('page'));
    
    function pageAvant() {
        if (page !== null && page >= 1) {
            window.location.href = window.location.pathname + "&page=" + (page - 1);
        }
    }
    function pageApres() {
        window.location.href = window.location.pathname + "&page=" + (page + 1);
    }
</script>

<div class="row">
    <div class="col-12 text-center mb-4">
        <h1 class="display-5 fw-bold text-primary">Liste des annonces</h1>
        <p class="lead text-muted">Mettez vous au courant</p>
    </div>
</div>

{% if annonces is empty %}
    <div class="row">
        <div class="col-12 text-center py-5">
            <div class="alert alert-info" role="alert">
                <i class="bi bi-info-circle-fill me-2"></i>
                Aucune annonce n'a été trouvée pour le moment.
            </div>
        </div>
    </div>
{% else %}
    <div class="row row-cols-1 row-cols-md-2 row-cols-lg-3 g-4">
        {% include "annonces/_annonces_list.html.twig" %}
    </div>
    <div class="d-flex justify-content-center gap-2 mt-5 mb-5">
        <button onclick="pageAvant()" class="btn btn-outline-primary px-4 py-2" id="btnAvant">
            <i class="bi bi-chevron-left"></i> Précédent
        </button>
        
        <button onclick="pageApres()" class="btn btn-primary px-4 py-2">
            Suivant <i class="bi bi-chevron-right"></i>
        </button>
    </div>
{% endif %}
{% endblock %}
