{% for annonce in annonces %}
    <div class="col">
        <div class="card h-100 shadow-sm hover-shadow transition-shadow">
            
            <div class="card-body d-flex flex-column">
                <div class="d-flex justify-content-between align-items-start mb-3">
                    <h5 class="card-title mb-0">
                        <a href="{{ path('app_annonces_show', {id: annonce.id}) }}"
                            class="text-decoration-none text-primary fw-bold hovered-underline">
                            {{ annonce.title }}
                        </a>
                    </h5>
                    <span class="badge rounded-pill text-bg-info">
                        Annonce
                    </span>
                </div>

                <p class="card-text text-muted small flex-grow-1">
                    {{ annonce.content|striptags|slice(0, 150) ~ (annonce.content|length > 150 ? '...' : '') }}
                </p>

                <hr class="my-3">

                <div class="text-muted small">
                    <div class="d-flex align-items-center mb-2">
                        <i class="bi bi-clock me-2 text-primary"></i>
                        <div>
                            Posté le {{ annonce.sent_at|format_datetime('medium', 'short', locale: 'fr') }}
                        </div>
                    </div>

                    <div class="d-flex align-items-center">
                        <i class="bi bi-person-circle me-2 text-secondary"></i>
                        <span>
                            Par <strong>{{ annonce.creator_username }}</strong>
                        </span>
                    </div>
                </div>

                <div class="mt-3 d-flex justify-content-end">
                    <a href="{{ path('app_annonces_show', {id: annonce.id}) }}" class="btn btn-sm btn-outline-primary">
                        Voir plus
                    </a>
                </div>
            </div>
        </div>
    </div>
{% endfor %}