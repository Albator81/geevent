<!DOCTYPE html>
<html>
<head>
    <meta charset="UTF-8">
    <title>{{ annonce.title }}</title>
</head>
<body style="font-family: 'Helvetica Neue', Helvetica, Arial, sans-serif; background-color: #f4f4f4; margin: 0; padding: 0;">

    <div style="max-width: 600px; margin: 0 auto; background-color: #ffffff; box-shadow: 0 0 10px rgba(0,0,0,0.1);">
        
        <div style="background-color: #0d6efd; padding: 30px; text-align: center;">
            <h1 style="color: #ffffff; margin: 0; font-size: 24px;">Nouvelle Annonce</h1>
        </div>

        <div style="padding: 30px;">
            <h2 style="color: #333333; margin-bottom: 20px;">{{ annonce.title }}</h2>

            <div style="font-size: 16px; line-height: 1.6; color: #555555; background-color: #f9f9f9; padding: 20px; border-left: 5px solid #0d6efd;">
                {{ annonce.content|raw }}
            </div>

            <p style="margin-top: 30px; font-size: 14px; color: #888;">
                Publié par <strong>{{ annonce.sentBy.username }}</strong> le {{ annonce.sentAt|date('d/m/Y') }}
            </p>

            <div style="text-align: center; margin-top: 40px;">
                <a href="{{ url('app_login') }}" style="background-color: #0d6efd; color: #ffffff; padding: 12px 25px; text-decoration: none; border-radius: 5px; font-weight: bold;">
                    Se connecter pour voir plus
                </a>
            </div>
        </div>

        <div style="background-color: #333333; color: #aaaaaa; padding: 20px; text-align: center; font-size: 12px;">
            <p style="margin: 0;">Cet email a été envoyé automatiquement par GeEvent.</p>
        </div>
    </div>

</body>
</html>