{% extends 'base.html.twig' %}

{% block title %}Liste des événements{% endblock %}

{% block body %}
<script>
    const urlParams = new URLSearchParams(window.location.search);
    const page = Number(urlParams.get('page'));
    const search = urlParams.get('search') ?? "";
    const display = urlParams.get('display') ?? "";
    
    function pageAvant() {
        if (page !== null && page >= 1) {
            window.location.href = window.location.pathname + "?display=" + display + "&search=" + search + "&page=" + (page - 1);
        }
    }

    function pageApres() {
        window.location.href = window.location.pathname + "?display=" + display + "&search=" + search + "&page=" + (page + 1);
    }
</script>

<div class="row">
    <div class="col-12 text-center mb-4">
        <h1 class="display-5 fw-bold text-primary">Liste des événements</h1>
        <p class="lead text-muted">Découvrez les événements à venir près de chez vous</p>
    </div>
</div>

{% if events is empty %}
    <div class="row">
        <div class="col-12 text-center py-5">
            <div class="alert alert-info" role="alert">
                <i class="bi bi-info-circle-fill me-2"></i>
                Aucun événement n'a été trouvé pour le moment.
            </div>
        </div>
    </div>
{% else %}
    <div class="row row-cols-1 row-cols-md-2 row-cols-lg-3 g-4">
        {% include "events/_events_list.html.twig" %}
    </div>
    <div class="d-flex justify-content-center gap-2 mt-5 mb-5">
        <button onclick="pageAvant()" class="btn btn-outline-primary px-4 py-2" id="btnAvant">
            <i class="bi bi-chevron-left"></i> Précédent
        </button>
        
        <button onclick="pageApres()" class="btn btn-primary px-4 py-2">
            Suivant <i class="bi bi-chevron-right"></i>
        </button>
    </div>
{% endif %}
{% endblock %}

{% block javascript %}
<script>
    document.addEventListener("DOMContentLoaded", function() {
        if (page <= 0) {
            const btn = document.getElementById('btnAvant');
            if (btn) {
                btn.disabled = true;
                btn.classList.add('disabled');
            }
        }
    });
</script>
{% endblock %}
