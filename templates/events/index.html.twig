{% extends 'base.html.twig' %}

{% block title %}Liste des événements{% endblock %}

{% block body %}
<div class="row">
    <div class="col-12 text-center mb-5">
        <h1 class="display-5 fw-bold text-primary">Liste des vénements</h1>
        <p class="lead text-muted">Découvrez les événements à venir près de chez vous</p>
    </div>
</div>

{% if events is empty %}
    <div class="row">
        <div class="col-12 text-center py-5">
            <div class="alert alert-info" role="alert">
                <i class="bi bi-info-circle-fill me-2"></i>
                Aucun événement n'a été trouvé pour le moment.
            </div>
        </div>
    </div>
{% else %}
    <div class="row row-cols-1 row-cols-md-2 row-cols-lg-3 g-4">
        {% for event in events %}
            <div class="col">
                <div class="card h-100 shadow-sm hover-shadow transition-shadow">
                    <div class="card-body d-flex flex-column">
                        <div class="d-flex justify-content-between align-items-start mb-3">
                            <h5 class="card-title mb-0">
                                <a href="{{ path('app_events_show', {id: event.id}) }}"
                                    class="text-decoration-none text-primary fw-bold hovered-underline">
                                    {{ event.title }}
                                </a>
                            </h5>
                            <span class="badge rounded-pill text-bg-{{ event.type.color|default('secondary') }}">
                                {{ event.type.value }}
                            </span>
                        </div>

                        <p class="card-text text-muted small flex-grow-1">
                            {{ event.description }}
                        </p>

                        <hr class="my-3">

                        <div class="text-muted small">
                            <div class="d-flex align-items-center mb-2">
                                <i class="bi bi-calendar-event me-2 text-primary"></i>
                                <div>
                                    <div>Du {{ event.startDatetime|format_datetime('medium', 'short', locale: 'fr') }} au {{ event.endDatetime|format_datetime('medium', 'short', locale: 'fr') }}</div>
                                </div>
                            </div>

                            <div class="d-flex align-items-center mb-2">
                                <i class="bi bi-people-fill me-2 text-success"></i>
                                {{ event.participants|length }} participant
                            </div>

                            <div class="d-flex align-items-center text-truncate">
                                <i class="bi bi-geo-alt-fill me-2 text-danger"></i>
                                <span class="text-truncate d-block" style="max-width: 250px;">
                                    {{ event.address }}
                                </span>
                            </div>
                        </div>

                        <div class="mt-3 d-flex justify-content-between align-items-center text-muted small">
                            <span>
                                <i class="bi bi-person-circle me-1"></i>
                                Par <strong>{{ event.createdBy.username }}</strong>
                            </span>
                            <div class="text">
                                <i class="bi bi-star-fill text-warning"></i>
                                {% if event.sponsors|length > 0 %}
                                        {{ event.sponsors|length }} sponsors
                                {% else %}
                                        Aucun sponsors
                                {% endif %}
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        {% endfor %}
    </div>
{% endif %}
{% endblock %}
