{% extends 'base.html.twig' %}

{% block title %}Liste des événements{% endblock %}

{% block body %}
<div class="row">
    <div class="col-12 text-center mb-4">
        <h1 class="display-5 fw-bold text-primary">Liste des événements</h1>
        <p class="lead text-muted">Découvrez les événements à venir près de chez vous</p>
    </div>
</div>

{% if events is empty %}
    <div class="row">
        <div class="col-12 text-center py-5">
            <div class="alert alert-info" role="alert">
                <i class="bi bi-info-circle-fill me-2"></i>
                Aucun événement n'a été trouvé pour le moment.
            </div>
        </div>
    </div>
{% else %}
    <div class="row row-cols-1 row-cols-md-2 row-cols-lg-3 g-4 pb-5">
        {{ include('events/_events_list.html.twig') }}
    </div>
    {% if maxPage > 0 %}
            <div class="pagination-container">
                <div class="d-flex justify-content-center align-items-center gap-3">
                    {% if currentPage > 0 %}
                        <a href="{{ path('app_events', {page: currentPage - 1}) }}" class="btn btn-outline-primary px-4">
                            &lt; Précédent
                        </a>
                    {% else %}
                        <button class="btn btn-outline-secondary px-4" disabled>&lt; Précédent</button>
                    {% endif %}

                    <span class="text-muted fw-bold">Page {{ currentPage + 1 }} / {{ maxPage + 1 }}</span>

                    {% if currentPage < maxPage %}
                        <a href="{{ path('app_events', {page: currentPage + 1}) }}" class="btn btn-primary px-4">
                            Suivant &gt;
                        </a>
                    {% else %}
                        <button class="btn btn-outline-secondary px-4" disabled>Suivant &gt;</button>
                    {% endif %}
                </div>
            </div>
        {% endif %}
{% endif %}
{% endblock %}