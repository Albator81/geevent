{% extends 'base.html.twig' %}

{% block title %}{{ event.title }} | Détails de l'événement{% endblock %}

{% block stylesheets %}
    <link rel="stylesheet" href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css" integrity="sha256-p4NxAoJBhIIN+hmNHrzRCf9tD/miZyoHS5obTRR9BMY=" crossorigin="" />
{% endblock %}

{% block body %}
    <div class="text-center">
        <h1 class="display-10 text-primary fw-bold mb-4">{{ event.title }}</h1>
    </div>
    <a href="{{ path('app_events') }}" class="btn btn-outline-secondary mb-5">
        <i class="bi bi-arrow-left me-2"></i>Retour à la liste
    </a>
    <div class="row g-4">
        <div class="col-lg-6 d-flex flex-column">
            <div class="card shadow-sm rounded p-4 d-flex flex-column justify-content-between overflow-hidden">
                <div class="d-flex align-items-start mb-3">
                    <i class="bi bi-lightbulb text-primary me-3 fs-5"></i>
                    <div>
                        <strong>Type d'évenement :</strong><br>
                        {{ event.type.value }}
                    </div>
                </div>

                <div class="d-flex align-items-start mb-3">
                    <i class="bi bi-calendar-event text-primary me-3 fs-5"></i>
                    <div>
                        <strong>Période :</strong><br>
                        Du {{ event.startDatetime|format_datetime('medium', 'short', locale: 'fr') }}
                        au {{ event.endDatetime|format_datetime('medium', 'short', locale: 'fr') }}
                    </div>
                </div>

                <div class="d-flex align-items-start mb-3">
                    <i class="bi bi-geo-alt-fill text-danger me-3 fs-5"></i>
                    <div>
                        <strong>Localisation :</strong><br>
                        {{ event.address }}
                    </div>
                </div>

                <div class="d-flex align-items-start mb-3">
                    <i class="bi bi-people-fill text-success me-3 fs-5"></i>
                    <div>
                        <strong>Participants :</strong><br>
                        {{ event.participants|length }} participants
                    </div>
                </div>

                <div class="d-flex align-items-start mb-3">
                    <i class="bi bi-person-circle me-3 fs-5"></i>
                    <div>
                        <strong>Organisé par :</strong><br>
                        {{ event.createdBy.username }}
                    </div>
                </div>

                <div class="align-items-start">
                    <div class="d-flex align-items-start">
                        <i class="bi bi-star-fill text-warning me-3 fs-5"></i>
                        <div>
                            <strong>Sponsors :</strong><br>
                        </div>
                    </div>

                    <div class="grow">
                        {% if event.sponsors is not empty %}
                            <div class="d-flex gap-3 align-items-center py-3 overflow-x-auto flex-nowrap w-100">
                                {% for sponsor in event.sponsors %}
                                    <a href="{{ sponsor.websiteurl }}" target="_blank"
                                    class="text-decoration-none bg-light rounded p-2 d-flex align-items-center justify-content-start shadow-sm"
                                    style="min-width: 160px;">
                                        <img
                                            src="{{ sponsor.logoPath ? asset('uploads/sponsors/' ~ sponsor.logoPath) : asset('uploads/sponsors/default.png') }}"
                                            alt="{{ sponsor.name }}"
                                            class="rounded-circle border me-2"
                                            style="width: 50px; height: 50px; object-fit: cover;">
                                        <span class="fw-semibold text-dark text-truncate">{{ sponsor.name }}</span>
                                    </a>
                                {% endfor %}
                            </div>
                        {% else %}
                            Aucun sponsor
                        {% endif %}
                    </div>
                </div>

                <div class="mt-3">
                    <h5 class="fw-bold mb-2 text-primary">Description</h5>
                    <p class="text-muted">{{ event.description|raw }}</p>
                </div>

                {% set now = 'now'|date('Y-m-d H:i:s') %}
                {% set end = event.endDatetime|date('Y-m-d H:i:s') %}
                {% set isPast = end < now %}

                {% if not isPast %}
                    {% if hasJoined %}
                        <hr>
                        <div class="d-flex justify-content-center">
                            <a href="{{ path('app_events_leave', {id: event.id}) }}" class="btn btn-outline-danger d-flex align-items-center">
                                <i class="bi bi-box-arrow-in-right me-2"></i>
                                Quitter l'évènement
                            </a>
                        </div>
                    {% else %}
                        <hr>
                        <div class="d-flex justify-content-center">
                            <a href="{{ path('app_events_join', {id: event.id}) }}" class="btn btn-outline-primary d-flex align-items-center">
                                <i class="bi bi-box-arrow-in-right me-2"></i>
                                Rejoindre l'évènement
                            </a>
                        </div>
                    {% endif %}
                {% else %}
                    <div class="alert alert-danger text-center mt-3">
                        Cet évènement est terminé.
                    </div>
                {% endif %}
            </div>
        </div>
        <div class="col-lg-6 d-flex flex-column">
            <div class="ratio ratio-16x9 mb-3 rounded shadow-sm">
                <img src="{{ event.cover ? asset('uploads/events/' ~ event.cover) : asset('uploads/events/default.png') }}" class="card-img-top" alt="Image de couverture de l'événement {{ event.title }}">
            </div>
            {% if event.latitude is not null and event.longitude is not null %}
                <div id="map" class="flex-grow-1 shadow rounded" style="min-height:400px;"></div>
            {% else %}
                <div class="flex-grow-1 shadow rounded d-flex align-items-center justify-content-center bg-light" style="min-height:400px;">
                    <div class="text-center text-muted">
                        <i class="bi bi-geo-alt-slash fs-1"></i>
                        <p class="mt-2 fw-bold">Carte non disponible</p>
                        <small>Nous n'avons pas réussi à localiser cet événement. Merci de vous référer à l'adresse postale.</small>
                    </div>
                </div>
            {% endif %}
        </div>
    </div>
{% endblock %}

{% block javascripts %}
    {% if event.latitude is not null and event.longitude is not null %}
        <script src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js" integrity="sha256-20nQCchB9co0qIjJZRGuk2/Z9VM+kNiyxNV1lvTlZBo=" crossorigin=""></script>
        <script>
            const map = L.map('map').setView([{{ event.latitude }}, {{ event.longitude }}], 15);
            L.tileLayer('https://tile.openstreetmap.org/{z}/{x}/{y}.png', {
                minZoom: 10,
                maxZoom: 18,
                attribution: '&copy; <a href="http://www.openstreetmap.org/copyright">OpenStreetMap</a>'
            }).addTo(map);
            L.marker([{{ event.latitude }}, {{ event.longitude }}]).addTo(map)
                .bindPopup("C'est ici !")
                .openPopup()
                .on('click', function(e) {
                    map.setView(e.latlng, map.getZoom() < 15 ? 15 : map.getZoom() , { animate: true });
                });
        </script>
    {% endif %}
{% endblock %}
