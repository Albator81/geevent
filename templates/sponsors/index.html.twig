{% extends 'base.html.twig' %}

{% block title %}Nos Sponsors{% endblock %}

{% block body %}
    <div class="sponsors-page-container">
        <div class="text-center mb-5">
            <h1 class="display-4">Ils nous soutiennent</h1>
            <p class="lead text-muted">Merci à nos incroyables partenaires qui rendent nos événements possible.</p>
        </div>

        <div class="sponsors-grid">
            {% for sponsor in sponsors %}
            {% set tagName = sponsor.websiteUrl ? 'a' : 'div' %}

            <{{ tagName }}
            {% if sponsor.websiteUrl %}href="{{ sponsor.websiteUrl }}" target="_blank" rel="noopener"{% endif %}
            class="sponsor-card"
            >
            <div class="img-container">
                {% if sponsor.logoPath %}
                    <img src="{{ asset('uploads/sponsors/' ~ sponsor.logoPath) }}" alt="{{ sponsor.name }}" class="sponsor-img">
                {% else %}
                    <span style="font-size: 3rem; color: #ccc;">📷</span>
                {% endif %}
            </div>

            <div class="sponsor-name">
                {{ sponsor.name }}
            </div>
        </{{ tagName }}>
        {% else %}
            <div class="col-12 text-center">
                <p>Aucun sponsor n'est enregistré pour le moment.</p>
            </div>
        {% endfor %}
    </div>
    </div>

    <style>
        .sponsors-page-container {
            max-width: 1200px;
            margin: 0 auto;
            padding: 4rem 1rem;
        }

        .sponsors-grid {
            display: grid;
            grid-template-columns: repeat(auto-fill, minmax(220px, 1fr));
            gap: 2rem;
            justify-items: center;
        }
        .sponsor-card {
            background: #fff;
            border-radius: 12px;
            box-shadow: 0 4px 15px rgba(0,0,0,0.05);
            padding: 1.5rem;
            width: 100%;
            height: 220px;
            display: flex;
            flex-direction: column;
            justify-content: center;
            align-items: center;

            transition: transform 0.3s ease, box-shadow 0.3s ease;
            text-decoration: none;
            color: inherit;
            border: 1px solid #f0f0f0;
        }

        .sponsor-card:hover {
            transform: translateY(-5px);
            box-shadow: 0 10px 25px rgba(0,0,0,0.1);
            border-color: #e0e0e0;
            color: inherit;
        }

        .img-container {
            height: 120px;
            width: 100%;
            display: flex;
            align-items: center;
            justify-content: center;
            margin-bottom: 1rem;
        }

        .sponsor-img {
            max-width: 100%;
            max-height: 100%;
            object-fit: contain;
        }

        .sponsor-name {
            font-weight: bold;
            font-size: 1.1rem;
            color: #333;
            text-align: center;
            white-space: nowrap;
            overflow: hidden;
            text-overflow: ellipsis;
            width: 100%;
        }
    </style>
{% endblock %}
