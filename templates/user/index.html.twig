{% extends 'base.html.twig' %}

{% block title %}Mon Profil - {{ user.username }}{% endblock %}

{% block body %}
    <div class="container mt-5">
        <div class="row">
            <div class="col-md-4">
                <div class="card shadow-sm">
                    <div class="card-body text-center">
                        <img src="https://ui-avatars.com/api/?name={{ user.username }}&background=random&size=128"
                             class="rounded-circle mb-3" alt="Avatar">

                        <h4>{{ user.username }}</h4>
                        <p class="text-muted">{{ user.email }}</p>

                        <div class="d-grid gap-2">
                            {% if user.verified %}
                                <button class="btn btn-success btn-sm" disabled>Compte Vérifié ✓</button>
                            {% else %}
                                <button class="btn btn-warning btn-sm" disabled>Non Vérifié ⚠</button>
                            {% endif %}
                        </div>
                    </div>
                </div>
            </div>

            <div class="col-md-8">
                <div class="alert alert-info">
                    Les événements s'afficheront ici au prochain commit.
                </div>
            </div>
        </div>
    </div>
{% endblock %}
