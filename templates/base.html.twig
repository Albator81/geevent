<!DOCTYPE html>
<html lang="fr">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>{% block title %}LAB-I*{% endblock %}</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="shortcut icon" href="{{ asset('GeEvent_logo_img.png') }}" type="image/png">
    <link href="https://fonts.googleapis.com/icon?family=Material+Icons" rel="stylesheet">
    {% block stylesheets %}{% endblock %}
</head>
<body class="d-flex flex-column min-vh-100 bg-light">
    <nav class="navbar navbar-expand-lg navbar-light bg-white mb-4 shadow-sm">
        <div class="container">
            <a class="navbar-brand d-flex align-items-center" href="/">
                <img src="{{ asset('GeEvent_logo_img.png') }}" alt="Ge'Event logo" height="80" class="me-2">
            </a>
            <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarContent">
                <span class="navbar-toggler-icon"></span>
            </button>
            <div id="navbarContent" class="collapse navbar-collapse">
                <ul class="navbar-nav me-auto mb-2 mb-lg-0">
                    <li class="nav-item"><a href="{{ path('app_home') }}" class="nav-link text-dark">Accueil</a></li>
                    <li class="nav-item"><a href="{{ path('app_annonces') }}" class="nav-link text-dark">Annonces</a></li>
                    <li class="nav-item"><a href="{{ path('app_events') }}" class="nav-link text-dark">Events</a></li>
                </ul>
                <a href="{{ path('app_login') }}" class="btn btn-outline-primary d-flex align-items-center">
                    <span class="material-icons me-2">account_circle</span>
                    Espace personnel
                </a>
            </div>
        </div>
    </nav>
    <div class="container">
        {% for label, messages in app.flashes %}
            {% set bootstrapClass = {
                success: 'success',
                error: 'danger',
                danger: 'danger',
                warning: 'warning',
                info: 'info',
            }[label]|default('secondary') %}
            {% for message in messages %}
                <div class="alert alert-{{ bootstrapClass }} alert-dismissible fade show mt-3" role="alert">
                    {{ message }}
                    <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Fermer"></button>
                </div>
            {% endfor %}
        {% endfor %}
    </div>
    <main class="container flex-grow-1 py-4">
        {% block body %}{% endblock %}
    </main>
    <footer class="bg-dark text-white text-center py-3 mt-auto">
        <p class="mb-0">&copy; {{ "now"|date("Y") }} - Ge'Event</p>
    </footer>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>
    {% block javascripts %}{% endblock %}
</body>
</html>
