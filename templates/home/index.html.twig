{% extends 'base.html.twig' %}

{% block title %}Accueil - Ge'Event{% endblock %}

{% block body %}
    <section class="hero-section text-center py-5 bg-light mb-5 rounded-3">
        <div class="container">
            <h1 class="display-4 fw-bold text-primary">Bienvenue sur Ge'Event</h1>
            <p class="lead text-muted">La plateforme de gestion d'événements collaborative.</p>
            {% if not app.user %}
                <div class="mt-4 d-lg-none">
                    <a href="{{ path('app_login') }}" class="btn btn-primary btn-lg px-4 me-2">Se connecter</a>
                    <a href="{{ path('app_register') }}" class="btn btn-outline-primary btn-lg px-4">S'inscrire</a>
                </div>
            {% endif %}
        </div>
    </section>

    <div class="container">
        <section class="mb-5">
            <div class="d-flex justify-content-between align-items-center mb-4">
                <h2 class="h2 fw-bold">À venir prochainement</h2>
                <a href="{{ path('app_events') }}" class="btn btn-sm btn-outline-secondary">Tout voir &rarr;</a>
            </div>

            <div class="row g-4">
                {% for event in upcomingEvents %}
                    <div class="col-12 col-md-6 col-lg-4">
                        <div class="card h-100 shadow-sm border-0 event-card">
                            <div class="ratio ratio-16x9">
                                <img src="{{ event.cover ? asset('uploads/events/' ~ event.cover) : asset('uploads/events/default.png') }}" class="card-img-top" alt="Image de couverture de l'événement {{ event.title }}">
                            </div>

                            <div class="card-body d-flex flex-column">
                                <div class="mb-2">
                                    <span class="badge bg-primary">{{ event.type.value }}</span>
                                    <small class="text-muted ms-2">
                                        <i class="bi bi-clock"></i> {{ event.startDatetime|format_datetime('short', 'short', locale='fr') }}
                                    </small>
                                </div>

                                <h5 class="card-title fw-bold text-truncate">{{ event.title }}</h5>
                                <p class="card-text text-muted small flex-grow-1">
                                    {{ event.description|striptags|slice(0, 100) }}...
                                </p>

                                <a href="{{ path('app_events_show', {id: event.id}) }}" class="btn btn-outline-primary w-100 mt-3">
                                    Voir les détails
                                </a>
                            </div>
                        </div>
                    </div>
                {% else %}
                    <div class="col-12">
                        <div class="alert alert-light text-center border">
                            Aucun événement prévu pour le moment.
                        </div>
                    </div>
                {% endfor %}
            </div>
        </section>

        <hr class="my-5">

        <section class="mb-5">
            <div class="row">
                <div class="col-md-8 mx-auto">
                    <h2 class="h2 fw-bold mb-4">
                         Dernières Annonces
                    </h2>

                    {% for annonce in latestAnnonces %}
                        <div class="card mb-3 border-0 shadow-sm annonce-card">
                            <div class="card-body">
                                <div class="d-flex justify-content-between align-items-start mb-2">
                                    <h5 class="card-title mb-0 fw-bold">{{ annonce.title }}</h5>
                                    <small class="text-muted text-end" style="min-width: 120px;">
                                        {{ annonce.sentAt|format_datetime('relative_short', 'none', locale='fr') }}
                                    </small>
                                </div>
                                <h6 class="card-subtitle mb-2 text-primary small">
                                    Par {{ annonce.sentBy.username }}
                                </h6>
                                <p class="card-text bg-light p-3 rounded text-secondary">
                                    {{ annonce.content|nl2br }}
                                </p>
                            </div>
                        </div>
                    {% else %}
                        <div class="alert alert-light text-center border">
                            Aucune annonce récente.
                        </div>
                    {% endfor %}
                </div>
            </div>
        </section>
    </div>

    <style>
        .event-card {
            transition: transform 0.2s;
        }
        .event-card:hover {
            transform: translateY(-5px);
        }
        .annonce-card {
            border-left: 4px solid #0d6efd !important;
        }
    </style>
{% endblock %}
